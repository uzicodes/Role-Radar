generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Job {
  id                 String   @id @default(cuid())
  title              String
  company            String
  location           String?
  salary             String?
  experienceRequired String?
  link               String   @unique
  matchScore         Int?
  isRead             Boolean  @default(false)
  scrapedDate        String   @default("Nov 8 2026")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // The new composite index for the dashboard
  @@index([scrapedDate, createdAt])
}

model ScrapeRun {
  id              String   @id @default(cuid())
  totalBoards     Int
  succeededBoards Int
  failedBoards    Int
  newJobsFound    Int
  durationMs      Int?
  boardResults    Json
  createdAt       DateTime @default(now())
}
